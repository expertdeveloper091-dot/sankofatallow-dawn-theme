{% comment %}
  Clay Theme Product Purchase Section Addons
{% endcomment %}

{% case addon_type %}
  {% when 'live_visitors' %}
    <div class="clay-addon-box clay-live-visitors" {{ block.shopify_attributes }}>
      <span class="clay-live-dot"></span>
      <span class="clay-addon-text">
        <strong><span id="clay-live-count">24</span> people</strong> are viewing this product right now
      </span>
    </div>

  {% when 'stock_countdown' %}
    <div class="clay-addon-box clay-stock-countdown" {{ block.shopify_attributes }}>
      <div class="clay-stock-message">
        🔥 <strong>Hurry up!</strong> Only <span id="clay-stock-count">{{ block.settings.stock_items | default: 12 }}</span> left in stock!
      </div>
      <div class="clay-stock-bar-bg">
        <div class="clay-stock-bar-fill" style="width: {{ block.settings.stock_percent | default: 35 }}%;"></div>
      </div>
    </div>

  {% when 'sold_counter' %}
    <div class="clay-addon-box clay-sold-counter" {{ block.shopify_attributes }}>
      <svg class="clay-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      <span><strong>{{ block.settings.sold_count | default: 48 }} sold</strong> in the last {{ block.settings.sold_hours | default: 24 }} hours</span>
    </div>

  {% when 'delivery_info' %}
    <div class="clay-addon-box clay-delivery-box" {{ block.shopify_attributes }}>
      {% if block.settings.show_delivery %}
        <div class="clay-delivery-item">
          <svg class="clay-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <div>
            <strong>Estimated Delivery:</strong>
            <span>{{ block.settings.delivery_text | default: "3-5 Business Days" }}</span>
          </div>
        </div>
      {% endif %}
      {% if block.settings.show_discount_code %}
        <div class="clay-delivery-item clay-discount-code">
          <svg class="clay-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          <div>
            <span>Use code <strong>{{ block.settings.discount_code | default: "WELCOME15" }}</strong> for {{ block.settings.discount_percent | default: "15%" }} off on your first order.</span>
          </div>
        </div>
      {% endif %}
    </div>

  {% when 'product_addons' %}
    <div class="clay-addon-actions" {{ block.shopify_attributes }}>
      {% if block.settings.show_ask_question %}
        <button type="button" class="clay-action-btn" id="clay-ask-question-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Ask a Question
        </button>
      {% endif %}
      {% if block.settings.show_share %}
        <button type="button" class="clay-action-btn" onclick="if (navigator.share) { navigator.share({title: '{{ product.title | escape }}', url: window.location.href}); } else { navigator.clipboard.writeText(window.location.href); alert('Product URL copied to clipboard!'); }">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          Share
        </button>
      {% endif %}
    </div>

    <!-- Modal for Ask Question -->
    <div id="clay-ask-modal" class="clay-modal" style="display:none;">
      <div class="clay-modal-content">
        <div class="clay-modal-header">
          <h3>Ask a Question about {{ product.title | escape }}</h3>
          <button type="button" class="clay-modal-close" id="clay-ask-modal-close">&times;</button>
        </div>
        <div class="clay-modal-body">
          {% render 'ask-question-form' %}
        </div>
      </div>
    </div>

  {% when 'terms_checkbox' %}
    <div class="clay-addon-box clay-terms-checkbox" {{ block.shopify_attributes }}>
      <label class="clay-checkbox-label">
        <input type="checkbox" id="clay-agree-terms" required>
        <span>I agree with the <a href="{{ block.settings.terms_url | default: '/policies/terms-of-service' }}" target="_blank">Terms and Conditions</a></span>
      </label>
    </div>

  {% when 'trust_badges' %}
    <div class="clay-trust-badges-wrapper" {{ block.shopify_attributes }}>
      {% if block.settings.message != blank %}
        <div class="clay-trust-heading">{{ block.settings.message }}</div>
      {% endif %}
      {% if block.settings.trust_badge_image != blank %}
        <img src="{{ block.settings.trust_badge_image | image_url: width: 400 }}" alt="Trust Badges" class="clay-trust-img" style="max-width: {{ block.settings.image_width | default: 220 }}px;">
      {% else %}
        <div class="cart-payment-icons">
          <svg width="34" height="22" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#6C5CE7"/><path d="M12.5 12C12.5 13.9 11.2 15.5 9.5 16C10.8 16 12 15.1 12.4 13.8C12.5 13.2 12.5 12.6 12.5 12Z" fill="#FFF"/><path d="M18.8 8H16.2L14.5 16H16.5L17.2 13H19.5L19.9 15H21.9L20.2 8H18.8ZM17.6 11.4L18.2 9.2L19.1 11.4H17.6Z" fill="#FFF"/><path d="M23.5 16H25.4L27.2 8H25.3L23.5 16Z" fill="#FFF"/><path d="M29.8 11.8C29.8 10.4 28.5 10 27.5 9.6C26.7 9.3 26.3 9.1 26.3 8.7C26.3 8.3 26.8 8 27.6 8C28.6 8 29.5 8.3 30.1 8.7L30.7 7.1C29.9 6.6 28.9 6.4 27.7 6.4C25.7 6.4 24.3 7.5 24.3 9.1C24.3 10.3 25.4 10.9 26.3 11.3C27.1 11.7 27.7 12 27.7 12.5C27.7 13.1 27 13.5 26 13.5C24.9 13.5 23.8 13.1 23 12.6L22.3 14.3C23.3 15 24.7 15.4 26 15.4C28.2 15.4 29.8 14.2 29.8 11.8Z" fill="#FFF"/></svg>
          <svg width="34" height="22" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#1434CB"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/><path d="M19 6.8A6.97 6.97 0 0 1 21.6 12A6.97 6.97 0 0 1 19 17.2A6.97 6.97 0 0 1 16.4 12A6.97 6.97 0 0 1 19 6.8Z" fill="#FF5F00"/></svg>
          <svg width="34" height="22" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#003087"/><path d="M13.2 8H10.5L8.8 16H11.5L13.2 8Z" fill="#0079C1"/><path d="M22.5 8.2C21.8 8 20.8 7.8 19.5 7.8C17 7.8 15.2 9.1 15.2 11C15.2 12.4 16.5 13.1 17.5 13.6C18.5 14.1 18.8 14.4 18.8 14.8C18.8 15.4 18.1 15.7 17.2 15.7C15.9 15.7 14.8 15.3 14.1 14.9L13.5 16.7C14.5 17.2 15.8 17.5 17.1 17.5C19.8 17.5 21.5 16.2 21.5 14.2C21.5 11.8 18.1 11.5 18.1 10.4C18.1 10 18.6 9.6 19.5 9.6C20.4 9.6 21.3 9.8 21.9 10.1L22.5 8.2Z" fill="#00457C"/><path d="M27.5 8H25.4C24.7 8 24.2 8.4 24 8.9L21 16H23.8L24.4 14.4H27.9L28.2 16H30.6L27.5 8ZM25.1 12.5L26.3 9.3L27.3 12.5H25.1Z" fill="#0079C1"/></svg>
          <svg width="34" height="22" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#000000"/><path d="M15.4 12.7C15.4 10.6 17.1 9.4 19.5 9.4C20.6 9.4 21.4 9.6 22 9.9V9.5C22 8.3 21 7.6 19.6 7.6C18.6 7.6 17.7 7.9 17.1 8.3L16.4 6.8C17.3 6.2 18.6 5.8 20 5.8C22.6 5.8 24.1 7.1 24.1 9.7V15H22.1V13.8C21.4 14.6 20.3 15.1 19.1 15.1C17 15.1 15.4 13.9 15.4 12.7ZM22 11.8V11.2C21.4 10.9 20.7 10.7 19.7 10.7C18.3 10.7 17.5 11.3 17.5 12.2C17.5 13 18.2 13.6 19.4 13.6C20.8 13.6 22 12.9 22 11.8Z" fill="#FFF"/></svg>
        </div>
      {% endif %}
    </div>
{% endcase %}
