{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  main#MainContent {
    background-color: #fff9f2 !important;
  }

  .page-width--narrow,
  .shopify-policy__container {
    max-width: 1200px !important;
    width: 100% !important;
    margin: 60px auto !important;
    padding: 80px 30px !important;
    background: #ffffff !important;
    border: 2px solid #bb623a !important;
    border-radius: 24px !important;
    box-sizing: border-box !important;
  }

  .main-page-title,
  .shopify-policy__title h1 {
    font-size: 42px !important;
    line-height: 1.2 !important;
    color: #2a231e !important;
    font-weight: 800 !important;
    text-align: center !important;
    margin-top: 0 !important;
    margin-bottom: 20px !important;
  }

  .rte h2,
  .shopify-policy__body h2 {
    font-size: 24px !important;
    line-height: 1.3 !important;
    color: #7a4a2c !important;
    font-weight: 700 !important;
    margin-top: 28px !important;
    margin-bottom: 12px !important;
  }

  .rte p,
  .rte li,
  .shopify-policy__body p,
  .shopify-policy__body li {
    font-size: 16px !important;
    line-height: 1.8 !important;
    color: #5e5247 !important;
    margin-bottom: 16px !important;
  }

  @media (max-width: 990px) {
    .page-width--narrow,
    .shopify-policy__container {
      margin: 40px auto !important;
      padding: 50px 24px !important;
      border-radius: 18px !important;
    }

    .main-page-title,
    .shopify-policy__title h1 {
      font-size: 34px !important;
    }

    .rte h2,
    .shopify-policy__body h2 {
      font-size: 21px !important;
    }

    .rte p,
    .rte li,
    .shopify-policy__body p,
    .shopify-policy__body li {
      font-size: 15px !important;
    }
  }

  @media (max-width: 600px) {
    .page-width--narrow,
    .shopify-policy__container {
      margin: 24px auto !important;
      padding: 32px 18px !important;
      border-radius: 14px !important;
      border-width: 1.5px !important;
    }

    .main-page-title,
    .shopify-policy__title h1 {
      font-size: 26px !important;
      line-height: 1.25 !important;
      margin-bottom: 14px !important;
    }

    .rte h2,
    .shopify-policy__body h2 {
      font-size: 18px !important;
      margin-top: 22px !important;
      margin-bottom: 8px !important;
    }

    .rte p,
    .rte li,
    .shopify-policy__body p,
    .shopify-policy__body li {
      font-size: 14px !important;
      line-height: 1.7 !important;
    }
  }

  @media (max-width: 380px) {
    .page-width--narrow,
    .shopify-policy__container {
      padding: 24px 14px !important;
    }

    .main-page-title,
    .shopify-policy__title h1 {
      font-size: 22px !important;
    }

    .rte h2,
    .shopify-policy__body h2 {
      font-size: 16px !important;
    }
  }
{%- endstyle -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ page.title | escape }}
  </h1>
  <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
