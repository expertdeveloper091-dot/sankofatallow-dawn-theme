<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet"/>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .custom-compare-cards-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color | default: '#F8F2EB' }};
    --text-color: {{ section.settings.text_color | default: '#222222' }};
    --heading-color: {{ section.settings.heading_color | default: '#1F1F1F' }};
    --subheading-color: {{ section.settings.subheading_color | default: '#666666' }};
    --accent-color: {{ section.settings.accent_color | default: '#C96E3D' }};
    --tag-bg: {{ section.settings.tag_bg | default: '#FFFFFF' }};
    --tag-border: {{ section.settings.tag_border | default: '#EAD9C8' }};
    --tag-text: {{ section.settings.tag_text | default: '#C96E3D' }};
    
    /* Left Card Colors */
    --left-card-bg: {{ section.settings.left_card_bg | default: '#FFFFFF' }};
    --left-card-border: {{ section.settings.left_card_border | default: '#ECECEC' }};
    --left-title-color: {{ section.settings.left_title_color | default: '#1F1F1F' }};
    --left-item-icon-bg: {{ section.settings.left_item_icon_bg | default: '#D9534F' }};
    --left-item-icon-color: {{ section.settings.left_item_icon_color | default: '#FFFFFF' }};
    --left-item-title-color: {{ section.settings.left_item_title_color | default: '#222222' }};
    --left-item-text-color: {{ section.settings.left_item_text_color | default: '#555555' }};

    /* Right Card Colors */
    --right-card-bg-start: {{ section.settings.right_card_bg_start | default: '#FFFFFF' }};
    --right-card-bg-end: {{ section.settings.right_card_bg_end | default: '#FFF7F0' }};
    --right-card-border: {{ section.settings.right_card_border | default: '#C96E3D' }};
    --right-title-color: {{ section.settings.right_title_color | default: '#1F1F1F' }};
    --right-badge-bg: {{ section.settings.right_badge_bg | default: '#C96E3D' }};
    --right-badge-text: {{ section.settings.right_badge_text_color | default: '#FFFFFF' }};
    --right-item-icon-bg: {{ section.settings.right_item_icon_bg | default: '#2FA86D' }};
    --right-item-icon-color: {{ section.settings.right_item_icon_color | default: '#FFFFFF' }};
    --right-item-title-color: {{ section.settings.right_item_title_color | default: '#222222' }};
    --right-item-text-color: {{ section.settings.right_item_text_color | default: '#555555' }};

    background-color: var(--bg-color);
    color: var(--text-color);
    font-family: 'Poppins', sans-serif !important;
    position: relative;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .custom-compare-cards-{{ section.id }} * {
    box-sizing: border-box;
  }

  .custom-compare-cards-{{ section.id }} .ccc-container {
    max-width: {{ section.settings.container_width | default: 1320 }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .custom-compare-cards-{{ section.id }} .ccc-heading {
    text-align: center;
    max-width: {{ section.settings.heading_max_width | default: 760 }}px;
    margin: 0 auto {{ section.settings.heading_margin_bottom | default: 60 }}px;
  }

  .custom-compare-cards-{{ section.id }} .ccc-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    background-color: var(--tag-bg);
    border: 1.5px solid var(--tag-border);
    border-radius: 50px;
    font-size: 14px;
    font-weight: 600;
    color: var(--tag-text);
    margin-bottom: 18px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
  }

  .custom-compare-cards-{{ section.id }} .ccc-title {
    font-family: 'Poppins', sans-serif !important;
    font-size: {{ section.settings.heading_font_size | default: 48 }}px;
    font-weight: 800;
    line-height: 1.12;
    margin: 0 0 20px 0;
    color: var(--heading-color);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .custom-compare-cards-{{ section.id }} .ccc-subheading,
  .custom-compare-cards-{{ section.id }} .ccc-subheading p {
    font-size: {{ section.settings.subheading_font_size | default: 17 }}px;
    line-height: 1.75;
    color: var(--subheading-color);
    margin: 0;
  }

  .custom-compare-cards-{{ section.id }} .ccc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 35px;
    align-items: stretch;
  }

  .custom-compare-cards-{{ section.id }} .ccc-card {
    background-color: var(--left-card-bg);
    border-radius: {{ section.settings.card_border_radius | default: 28 }}px;
    padding: 42px;
    box-shadow: 0 18px 45px rgba(0,0,0,0.06);
    position: relative;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
    overflow: visible;
    display: flex;
    flex-direction: column;
  }

  .custom-compare-cards-{{ section.id }} .ccc-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 24px 55px rgba(0,0,0,0.1);
  }

  .custom-compare-cards-{{ section.id }} .ccc-card.ccc-card--old {
    border: 1.5px solid var(--left-card-border);
  }

  .custom-compare-cards-{{ section.id }} .ccc-card.ccc-card--new {
    border: 2.5px solid var(--right-card-border);
    background: linear-gradient(180deg, var(--right-card-bg-start), var(--right-card-bg-end));
  }

  /* Simple Pill Badge */
  .custom-compare-cards-{{ section.id }} .ccc-badge {
    position: absolute;
    top: 22px;
    right: 22px;
    background-color: var(--right-badge-bg);
    color: var(--right-badge-text);
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    box-shadow: 0 4px 10px rgba(201, 110, 61, 0.25);
    z-index: 2;
  }

  /* Seal Stamp Badge (Image 2 style) */
  .custom-compare-cards-{{ section.id }} .ccc-badge-seal {
    position: absolute;
    top: -24px;
    right: 20px;
    z-index: 10;
  }

  .custom-compare-cards-{{ section.id }} .ccc-seal-outer {
    position: relative;
    width: 90px;
    height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.18));
    transform: rotate(5deg);
    transition: transform 0.3s ease;
  }

  .custom-compare-cards-{{ section.id }} .ccc-card--new:hover .ccc-seal-outer {
    transform: rotate(0deg) scale(1.08);
  }

  .custom-compare-cards-{{ section.id }} .ccc-seal-starburst {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .custom-compare-cards-{{ section.id }} .ccc-seal-inner {
    position: relative;
    z-index: 2;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background-color: var(--right-badge-bg, #C96E3D);
    border: 2px dashed rgba(255, 255, 255, 0.7);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.2);
  }

  .custom-compare-cards-{{ section.id }} .ccc-seal-top-text {
    font-size: 7px;
    font-weight: 900;
    color: #FFFFFF;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-top: 1px;
    line-height: 1;
  }

  .custom-compare-cards-{{ section.id }} .ccc-seal-ribbon {
    background-color: #1F1F1F;
    color: #FFFFFF;
    padding: 3px 10px;
    margin: 3px -14px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    box-shadow: 0 3px 6px rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.25);
    z-index: 3;
    white-space: nowrap;
  }

  .custom-compare-cards-{{ section.id }} .ccc-ribbon-text {
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    line-height: 1;
    color: #FFFFFF;
  }

  .custom-compare-cards-{{ section.id }} .ccc-seal-bottom-text {
    font-size: 6.5px;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.95);
    letter-spacing: 0.8px;
    text-transform: uppercase;
    margin-bottom: 1px;
    line-height: 1;
  }

  /* Header style without icon */
  .custom-compare-cards-{{ section.id }} .ccc-card-header {
    display: flex;
    align-items: center;
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px dashed rgba(0, 0, 0, 0.08);
  }

  .custom-compare-cards-{{ section.id }} .ccc-card-header h3 {
    font-size: 28px;
    font-weight: 800;
    margin: 0;
    line-height: 1.2;
  }

  .custom-compare-cards-{{ section.id }} .ccc-card--old .ccc-card-header h3 {
    color: var(--left-title-color);
  }

  .custom-compare-cards-{{ section.id }} .ccc-card--new .ccc-card-header h3 {
    color: var(--right-title-color);
  }

  .custom-compare-cards-{{ section.id }} .ccc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
    flex: 1;
  }

  .custom-compare-cards-{{ section.id }} .ccc-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    font-size: 16px;
    line-height: 1.7;
  }

  .custom-compare-cards-{{ section.id }} .ccc-card--old .ccc-item {
    color: var(--left-item-text-color);
  }

  .custom-compare-cards-{{ section.id }} .ccc-card--new .ccc-item {
    color: var(--right-item-text-color);
  }

  /* List Item Icons (Solid Circle Checkmark / Cross) */
  .custom-compare-cards-{{ section.id }} .ccc-item-icon {
    min-width: 28px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 3px;
  }

  .custom-compare-cards-{{ section.id }} .ccc-item-icon svg {
    display: block;
    width: 28px;
    height: 28px;
  }

  .custom-compare-cards-{{ section.id }} .ccc-item-content {
    flex: 1;
  }

  .custom-compare-cards-{{ section.id }} .ccc-item-content strong {
    display: block;
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .custom-compare-cards-{{ section.id }} .ccc-card--old .ccc-item-content strong {
    color: var(--left-item-title-color);
  }

  .custom-compare-cards-{{ section.id }} .ccc-card--new .ccc-item-content strong {
    color: var(--right-item-title-color);
  }

  /* Trust Bar at bottom */
  .custom-compare-cards-{{ section.id }} .ccc-trust-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem 3rem;
    margin-top: 50px;
    padding-top: 30px;
    border-top: 1px dashed rgba(0,0,0,0.1);
  }

  .custom-compare-cards-{{ section.id }} .ccc-trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
    color: var(--heading-color);
  }

  .custom-compare-cards-{{ section.id }} .ccc-trust-item i {
    font-size: 18px;
    color: var(--accent-color);
  }

  @media screen and (max-width: 991px) {
    .custom-compare-cards-{{ section.id }} .ccc-title {
      font-size: 34px;
    }
    .custom-compare-cards-{{ section.id }} .ccc-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .custom-compare-cards-{{ section.id }} .ccc-card {
      padding: 30px 24px;
    }
    .custom-compare-cards-{{ section.id }} .ccc-card-header h3 {
      font-size: 24px;
    }
  }

  @media screen and (max-width: 576px) {
    .custom-compare-cards-{{ section.id }} .ccc-title {
      font-size: 26px;
    }
    .custom-compare-cards-{{ section.id }} .ccc-subheading,
    .custom-compare-cards-{{ section.id }} .ccc-subheading p {
      font-size: 15px;
    }
    .custom-compare-cards-{{ section.id }} .ccc-item {
      font-size: 14.5px;
    }
    .custom-compare-cards-{{ section.id }} .ccc-item-content strong {
      font-size: 16px;
    }
  }
{%- endstyle -%}

<div class="custom-compare-cards-{{ section.id }} section-{{ section.id }}-padding">
  <div class="ccc-container">

    <!-- Section Heading -->
    {%- if section.settings.heading != blank or section.settings.tag_label != blank -%}
      <div class="ccc-heading">
        {%- if section.settings.show_tag and section.settings.tag_label != blank -%}
          <span class="ccc-tag">
            <i class="{{ section.settings.tag_icon | default: 'ri-award-line' }}"></i>
            {{ section.settings.tag_label }}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="ccc-title">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="ccc-subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Comparison Grid -->
    <div class="ccc-grid">

      <!-- LEFT CARD: Conventional Lotions -->
      <div class="ccc-card ccc-card--old">
        <div class="ccc-card-header">
          <h3>{{ section.settings.left_title | default: 'Conventional Lotions' }}</h3>
        </div>

        <ul class="ccc-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'comparison_point' -%}
              {%- if block.settings.left_title != blank or block.settings.left_text != blank -%}
                <li class="ccc-item" {{ block.shopify_attributes }}>
                  <div class="ccc-item-icon ccc-item-icon--cross">
                    <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="14" cy="14" r="14" fill="{{ section.settings.left_item_icon_bg | default: '#D9534F' }}"/>
                      <path d="M9.5 9.5L18.5 18.5M18.5 9.5L9.5 18.5" stroke="{{ section.settings.left_item_icon_color | default: '#FFFFFF' }}" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <div class="ccc-item-content">
                    {%- if block.settings.left_title != blank -%}
                      <strong>{{ block.settings.left_title }}</strong>
                    {%- endif -%}
                    {%- if block.settings.left_text != blank -%}
                      <span>{{ block.settings.left_text }}</span>
                    {%- endif -%}
                  </div>
                </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <!-- RIGHT CARD: Sankofa Tallow Body Butter -->
      <div class="ccc-card ccc-card--new">
        {%- if section.settings.show_right_badge and section.settings.right_badge_text != blank -%}
          {%- if section.settings.badge_style == 'seal' -%}
            <div class="ccc-badge-seal">
              <div class="ccc-seal-outer">
                <svg viewBox="0 0 100 100" class="ccc-seal-starburst">
                  <path d="M50 0 L54 7 L62 2 L64 10 L73 8 L73 17 L82 17 L80 25 L88 28 L84 36 L92 41 L86 48 L93 55 L85 60 L90 68 L81 71 L84 80 L74 81 L74 90 L65 89 L62 97 L54 94 L50 100 L46 94 L38 97 L35 89 L26 90 L26 81 L16 80 L19 71 L10 68 L15 60 L7 55 L14 48 L8 41 L16 36 L12 28 L20 25 L18 17 L27 17 L27 8 L36 10 L38 2 L46 7 Z" fill="{{ section.settings.right_badge_bg | default: '#C96E3D' }}"/>
                </svg>
                <div class="ccc-seal-inner">
                  <div class="ccc-seal-top-text">{{ section.settings.seal_top_text | default: 'TOP RATED' }}</div>
                  <div class="ccc-seal-ribbon">
                    <span class="ccc-ribbon-text">{{ section.settings.right_badge_text }}</span>
                  </div>
                  <div class="ccc-seal-bottom-text">{{ section.settings.seal_bottom_text | default: '★ PRODUCT ★' }}</div>
                </div>
              </div>
            </div>
          {%- else -%}
            <div class="ccc-badge">
              {{ section.settings.right_badge_text }}
            </div>
          {%- endif -%}
        {%- endif -%}

        <div class="ccc-card-header">
          <h3>{{ section.settings.right_title | default: 'Sankofa Tallow Body Butter' }}</h3>
        </div>

        <ul class="ccc-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'comparison_point' -%}
              {%- if block.settings.right_title != blank or block.settings.right_text != blank -%}
                <li class="ccc-item">
                  <div class="ccc-item-icon ccc-item-icon--check">
                    <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="14" cy="14" r="14" fill="{{ section.settings.right_item_icon_bg | default: '#2FA86D' }}"/>
                      <path d="M8.5 14L12 17.5L19.5 10" stroke="{{ section.settings.right_item_icon_color | default: '#FFFFFF' }}" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <div class="ccc-item-content">
                    {%- if block.settings.right_title != blank -%}
                      <strong>{{ block.settings.right_title }}</strong>
                    {%- endif -%}
                    {%- if block.settings.right_text != blank -%}
                      <span>{{ block.settings.right_text }}</span>
                    {%- endif -%}
                  </div>
                </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

    </div>

    <!-- Trust Build Footer Bar -->
    {%- if section.settings.show_trust_bar -%}
      <div class="ccc-trust-bar">
        {%- if section.settings.trust_1_text != blank -%}
          <div class="ccc-trust-item">
            <i class="ri-shield-check-fill"></i>
            <span>{{ section.settings.trust_1_text }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.trust_2_text != blank -%}
          <div class="ccc-trust-item">
            <i class="ri-drop-fill"></i>
            <span>{{ section.settings.trust_2_text }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.trust_3_text != blank -%}
          <div class="ccc-trust-item">
            <i class="ri-heart-3-fill"></i>
            <span>{{ section.settings.trust_3_text }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.trust_4_text != blank -%}
          <div class="ccc-trust-item">
            <i class="ri-verified-badge-fill"></i>
            <span>{{ section.settings.trust_4_text }}</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Comparison Cards",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "checkbox",
      "id": "show_tag",
      "label": "Show top tag pill",
      "default": true
    },
    {
      "type": "text",
      "id": "tag_icon",
      "label": "Tag Remix Icon class",
      "default": "ri-award-line"
    },
    {
      "type": "text",
      "id": "tag_label",
      "label": "Tag label",
      "default": "Honest Comparison"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Sankofa Tallow Body Butter is Different"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading font size",
      "default": 48
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading / Description",
      "default": "<p>Most lotions rely on water, fillers, and long ingredient lists that provide temporary hydration. Sankofa Tallow takes a different approach—every ingredient is carefully selected to deeply nourish, protect, and support healthy skin naturally.</p>"
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subheading font size",
      "default": 17
    },
    {
      "type": "header",
      "content": "Left Card (Conventional / Old)"
    },
    {
      "type": "text",
      "id": "left_title",
      "label": "Left card title",
      "default": "Conventional Lotions"
    },
    {
      "type": "color",
      "id": "left_card_bg",
      "label": "Left card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "left_card_border",
      "label": "Left card border color",
      "default": "#ECECEC"
    },
    {
      "type": "color",
      "id": "left_title_color",
      "label": "Left card title color",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "left_item_icon_bg",
      "label": "Left item icon circle background",
      "default": "#D9534F"
    },
    {
      "type": "color",
      "id": "left_item_icon_color",
      "label": "Left item cross stroke color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "left_item_title_color",
      "label": "Left item title color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "left_item_text_color",
      "label": "Left item text color",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "Right Card (Sankofa Tallow / Best Choice)"
    },
    {
      "type": "text",
      "id": "right_title",
      "label": "Right card title",
      "default": "Sankofa Tallow Body Butter"
    },
    {
      "type": "checkbox",
      "id": "show_right_badge",
      "label": "Show Best Choice badge",
