{% if section.settings.enable_section and request.page_type == 'product' and product.available %}
    {% liquid 
        assign current_variant = product.selected_or_first_available_variant
        assign product_form_id = 'product-form-' | append: section.id
        assign image = current_variant.image | default: product.featured_image 
        assign img_size = section.settings.img_width | append: 'x' | append: section.settings.img_height
    %}

    <style>
        #md-sticky-atc {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            z-index: 9999999 !important;
            padding-top: {{ section.settings.pt }}rem;
            padding-bottom: {{ section.settings.pb }}rem;
            visibility: hidden;
            opacity: 0;
            transform: translateY(100%);
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, visibility 0.25s ease;
            border-top: 2px solid #111111;
            background-color: #fff9f2 !important;
            box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.12);
            font-family: 'Poppins', sans-serif !important;
        }
        #md-sticky-atc.show {
            visibility: visible !important;
            opacity: 1 !important;
            transform: translateY(0) !important;
        }
        #md-sticky-atc .page-width-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
            gap: 16px;
        }
        #md-sticky-atc .product-content {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        #md-sticky-atc .product-content img {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            border: 2px solid #111111;
            box-shadow: 0 2px 0 #111111;
            object-fit: cover;
            flex-shrink: 0;
        }
        #md-sticky-atc .product-info-text {
            display: flex;
            align-items: center;
        }
        #md-sticky-atc .product__title {
            margin: 0;
            font-weight: 800;
            font-size: 1.1rem;
            color: #111111;
            font-family: 'Poppins', sans-serif;
            line-height: 1.2;
        }
        #md-sticky-atc .product-form-wrapper {
            flex-shrink: 0;
        }
        #md-sticky-atc .form-controls-wrapper {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        #md-sticky-atc .select-variant-wrapper {
            position: relative;
            flex-shrink: 0;
        }
        #md-sticky-atc .select__select_variant {
            appearance: none;
            -webkit-appearance: none;
            background: #ffffff;
            border: 2px solid #111111;
            border-radius: 9999px !important;
            box-shadow: 0 3px 0 #111111;
            padding: 0 36px 0 16px;
            height: 48px;
            font-size: 13.5px;
            font-weight: 800;
            color: #111111;
            cursor: pointer;
            outline: none;
            font-family: 'Poppins', sans-serif;
            line-height: 44px;
        }
        #md-sticky-atc .select-variant-wrapper .icon-caret {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            pointer-events: none;
            width: 10px;
            height: 6px;
            color: #111111;
        }

        /* CLAY ATC BUTTON EXACT GLOBAL MATCH */
        #md-sticky-atc .clay-sticky-atc-btn {
            height: 48px;
            border-radius: 9999px !important;
            background: #C1663D !important;
            color: #ffffff !important;
            border: 2px solid #111111 !important;
            box-shadow: 0 4px 0 #111111 !important;
            font-size: 15px !important;
            font-weight: 900 !important;
            letter-spacing: 0.05em !important;
            text-transform: uppercase !important;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 28px;
            gap: 8px;
            transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.2s ease;
            min-width: 160px;
            font-family: 'Poppins', sans-serif !important;
        }
        #md-sticky-atc .clay-sticky-atc-btn:hover {
            background: #A8542F !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 0 #111111 !important;
        }
        #md-sticky-atc .clay-sticky-atc-btn:active {
            transform: translateY(2px);
            box-shadow: 0 2px 0 #111111 !important;
        }
        #md-sticky-atc .clay-sticky-atc-btn:disabled {
            background: #222222 !important;
            opacity: 0.85;
            cursor: not-allowed;
        }

        @media (max-width: 768px) {
            #md-sticky-atc {
                padding-top: 0.5rem;
                padding-bottom: 0.5rem;
            }
            #md-sticky-atc .page-width-inner {
                flex-direction: row;
                flex-wrap: wrap;
                gap: 8px;
                padding: 0 12px;
            }
            #md-sticky-atc .product-content {
                width: 100%;
                justify-content: space-between;
            }
            #md-sticky-atc .product-form-wrapper {
                width: 100%;
            }
            #md-sticky-atc .form-controls-wrapper {
                width: 100%;
                gap: 8px;
            }
            #md-sticky-atc .select-variant-wrapper {
                flex: 1;
            }
            #md-sticky-atc .select__select_variant {
                width: 100%;
                height: 44px;
                font-size: 12.5px;
                padding: 0 28px 0 12px;
                line-height: 40px;
                border-radius: 9999px !important;
            }
            #md-sticky-atc .clay-sticky-atc-btn {
                height: 44px;
                font-size: 13px !important;
                padding: 0 16px;
                min-width: unset;
                flex: 1.2;
                border-radius: 9999px !important;
            }
        }
    </style>

    <script>
        window.addEventListener('DOMContentLoaded', () => {
            const stickyATC = document.querySelector('#md-sticky-atc');
            if (!stickyATC) return;

            const img = stickyATC.querySelector('.product-content img');
            const form = stickyATC.querySelector('form');
            const selectField = stickyATC.querySelector('select[name="id"]');

            const getScrollThreshold = () => {
                const mainBtn = document.querySelector('.clay-atc-btn') || 
                                document.querySelector('button[name="add"]:not(#md-sticky-atc button)') ||
                                document.querySelector('form[action*="/cart/add"] button[name="add"]');
                if (mainBtn) {
                    const rect = mainBtn.getBoundingClientRect();
                    return rect.bottom + window.scrollY + Number(stickyATC.dataset.offset || 0);
                }
                return 300;
            };

            let threshold = getScrollThreshold();

            window.addEventListener('resize', () => {
                threshold = getScrollThreshold();
            });

            window.addEventListener('scroll', () => {
                if (window.scrollY > threshold) {
                    stickyATC.classList.add('show');
                    document.documentElement.style.paddingBottom = `${stickyATC.clientHeight}px`;
                } else {
                    stickyATC.classList.remove('show');
                    document.documentElement.style.paddingBottom = '0';
                }
            });

            if (selectField) {
                selectField.addEventListener('change', () => {
                    const selectedOpt = selectField.options[selectField.selectedIndex];
                    if (img && selectedOpt && selectedOpt.dataset.img) {
                        img.setAttribute('src', selectedOpt.dataset.img);
                    }
                    const mainVarInput = document.getElementById('ClayVariantIdInput') || document.querySelector('.product-form [name="id"]');
                    if (mainVarInput && mainVarInput.value !== selectField.value) {
                        mainVarInput.value = selectField.value;
                        mainVarInput.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                });
            }

            const syncVariantToSticky = (val) => {
                if (selectField && val) {
                    selectField.value = val;
                    const selectedOpt = selectField.options[selectField.selectedIndex];
                    if (img && selectedOpt && selectedOpt.dataset.img) {
                        img.setAttribute('src', selectedOpt.dataset.img);
                    }
                }
            };

            document.querySelectorAll('form [name="id"], input[name="id"]#ClayVariantIdInput').forEach((input) => {
                if (input !== selectField) {
                    input.addEventListener('change', (e) => {
                        syncVariantToSticky(e.target.value);
                    });
                }
            });

            if (form) {
                form.addEventListener('submit', (e) => {
                    e.preventDefault();
                    const btn = form.querySelector('button[name="add"]');
                    const btnSpan = btn ? btn.querySelector('span') : null;
                    const spinner = btn ? btn.querySelector('.loading__spinner') : null;

                    if (btnSpan) {
                        btnSpan.dataset.origText = btnSpan.textContent;
                        btnSpan.textContent = 'ADDING...';
                    }
                    if (spinner) spinner.classList.remove('hidden');
                    if (btn) btn.disabled = true;

                    const formData = new FormData(form);
                    fetch('/cart/add.js', {
                        method: 'POST',
                        body: formData
                    })
                    .then(res => {
                        if (!res.ok) throw new Error('Network error');
                        return res.json();
                    })
                    .then(data => {
                        if (btnSpan) btnSpan.textContent = 'ADDED!';
                        setTimeout(() => {
                            if (btnSpan) btnSpan.textContent = btnSpan.dataset.origText || 'ADD TO CART';
                            if (btn) btn.disabled = false;
                            if (spinner) spinner.classList.add('hidden');
                        }, 1800);

                        fetch('/cart.js').then(r => r.json()).then(cart => {
                            document.querySelectorAll('.cart-count-bubble span, .cart-count-bubble, [data-cart-count]').forEach(el => {
                                el.textContent = cart.item_count;
                            });
                        });

                        if (typeof window.openCustomCartDrawer === 'function') {
                            window.openCustomCartDrawer();
                        } else {
                            const drawer = document.getElementById('cart-drawer');
                            if (drawer) {
                                drawer.classList.add('active');
                                drawer.setAttribute('aria-hidden', 'false');
                                const overlay = document.getElementById('hdr-overlay');
                                if (overlay) overlay.classList.add('active');
                                document.body.style.overflow = 'hidden';
                                document.documentElement.classList.add('drawer-open');
                            }
                        }
                    })
                    .catch(err => {
                        console.error('Sticky ATC form error:', err);
                        if (btnSpan) btnSpan.textContent = btnSpan.dataset.origText || 'ADD TO CART';
                        if (btn) btn.disabled = false;
                        if (spinner) spinner.classList.add('hidden');
                    });
                });
            }
        });
    </script>

    <div id="md-sticky-atc" class="color-{{ section.settings.color_scheme }}" aria-hidden="true" data-offset="{{ section.settings.offset }}">
        <div class="page-width">
            <div class="page-width-inner">
                <div class="product-content">
                    {% if section.settings.show_img %}
                        <img
                            src="{{ image | img_url: img_size, crop: 'center' }}"
                            alt="{{ product.title | escape }}"
                            width="{{ section.settings.img_width }}"
                            height="{{ section.settings.img_height }}"
                            loading="lazy">
                    {% endif %}
                    <div class="product-info-text">
                        <h3 class="product__title {{ section.settings.title_size }}">
                            {{ product.title }}
                        </h3>
                    </div>
                </div>

                <div class="product-form-wrapper">
                    {%- form 'product', product, id: product_form_id, class: 'product-form-sticky', novalidate: 'novalidate' -%}
                        <div class="form-controls-wrapper">
                            {% unless product.has_only_default_variant %}
                                <div class="select-variant-wrapper">
                                    <select class="select__select_variant" name="id" aria-label="Select variant">
                                        {% for variant in product.variants %}
                                            {% assign variant_image = variant.image | default: product.featured_image %}
                                            <option 
                                                value="{{ variant.id }}"
                                                data-img="{{ variant_image | img_url: img_size }}"
                                                {% if current_variant.id == variant.id %}selected{% endif %}>
                                                {{ variant.title }} - {{ variant.price | money }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-caret" viewBox="0 0 10 6">
                                        <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"></path>
                                    </svg>
                                </div>
                            {% else %}
                                <input type="hidden" name="id" value="{{ current_variant.id }}">
                            {% endunless %}

                            <button type="submit" name="add" class="clay-sticky-atc-btn" {% unless current_variant.available %}disabled{% endunless %}>
                                <span>
                                    {%- if current_variant.available -%}
                                        {{ 'products.product.add_to_cart' | t }}
                                    {%- else -%}
                                        {{ 'products.product.sold_out' | t }}
                                    {%- endif -%}
                                </span>
                                <div class="loading__spinner hidden">
                                    <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                                        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30" style="stroke: #ffffff;"></circle>
                                    </svg>
                                </div>
                            </button>
                        </div>
                    {% endform %}
                </div>
            </div>
        </div>
    </div>
{% endif %}

{% schema %}
{
    "name": "Sticky ATC",
    "settings": [
        {
            "type": "header",
            "content": "General"
        },
        {
            "type": "checkbox",
            "id": "enable_section",
            "label": "Enable \"Sticky ATC\"",
            "info": "Quickly enable or disable this feature",
            "default": true
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "scheme-1"
        },
        {
            "type": "select",
            "id": "title_size",
            "label": "Title Size",
            "default": "h4",
            "options": [
                {  "value": "h1", "label": "H1" },
                {  "value": "h2", "label": "H2" },
                {  "value": "h3", "label": "H3" },
                {  "value": "h4", "label": "H4" },
                {  "value": "h5", "label": "H5" },
                {  "value": "h6", "label": "H6" }
            ]
        },
        {
            "type": "checkbox",
            "id": "show_img",
            "default": true,
            "label": "Show image"
        },
        {
            "type": "text",
            "id": "img_width",
            "default": "80",
            "label": "Image width (px)"
        },
        {
            "type": "text",
            "id": "img_height",
            "default": "80",
            "label": "Image height (px)"
        },
        {
            "type": "select",
            "id": "btn_style",
            "options": [
                { "value": "primary", "label": "Primary" },
                { "value": "secondary", "label": "Secondary" }
            ],
            "default": "primary",
            "label": "'Add to cart' button style"
        },
        {
            "type": "header",
            "content": "Advanced"
        },
        {
            "type": "range",
            "id": "offset",
            "label": "Offset",
            "min": 0,
            "max": 500,
            "step": 10,
            "default": 0,
            "info": "Adjust the offset value when showing the Sticky ATC section related to the main product form."
        },
        {
            "type": "header",
            "content": "Spacing",
            "info": "Based on 'rem' values [Learn more](https://developer.mozilla.org/en-US/docs/Learn/CSS/Building_blocks/Values_and_units)"
        },
        {
            "type": "range",
            "id": "pt",
            "label": "Padding top",
            "min": 0,
            "max": 5,
            "step": 0.5,
            "default": 0.5
        },
        {
            "type": "range",
            "id": "pb",
            "label": "Padding bottom",
            "min": 0,
            "max": 5,
            "step": 0.5,
            "default": 0.5
        }
    ],
    "presets": [
        {
            "name": "Sticky ATC"
        }
    ]
}
{% endschema %}
